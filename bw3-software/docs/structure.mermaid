classDiagram
    class AbstractPeripheral {
        <<abstract>>
        +setup()
    }
    class Motor {
        +forward(int)
        +backward(int)
        +stop()
        +setup()
        -PwmPin* pinA
        -PwmPin* pinB
        -PwmSink* sink
        -const char* descriptor
    }
    class ReflectanceSensor {
        +setup()
        +isDark() const
        +isLight() const
        +update()
        -double reflectanceValue
        -int readPinNumber
    }
    class BallShooter {
        <<abstract>>
        +~BallShooter()
    }
    class ServoBallShooter {
        // empty
    }
    class PwmPin {
        +setup()
        +analogWrite(uint8_t)
        -int pin_
        -ESP32PWM pwm_
    }
    class PwmSink {
        +set(PwmPin*, int)
        +flush()
        -vector<Entry> entries_
    }
    AbstractPeripheral <|-- Motor
    AbstractPeripheral <|-- ReflectanceSensor
    AbstractPeripheral <|-- BallShooter
    BallShooter <|-- ServoBallShooter
    Motor o-- PwmPin
    Motor o-- PwmSink
    %% Korrektur: ServoBallShooter erbt nur von BallShooter, BallShooter erbt von AbstractPeripheral
    %% InputInterpreter hierarchy
    class InputInterpreter {
        <<abstract>>
        +interpretInput(int, int)
        -Motor* leftMotor
        -Motor* rightMotor
        -ReflectanceSensor* leftSensor
        -ReflectanceSensor* rightSensor
        -BallShooter* ballShooter
    }
    class SliderInputInterpreter {
        +interpretInput(int, int)
    }
    class OverriddenInputInterpreter {
        +interpretInput(int, int)
    }
    class JoystickInputInterpreter {
        // empty
    }
    InputInterpreter <|-- SliderInputInterpreter
    InputInterpreter <|-- OverriddenInputInterpreter
    InputInterpreter <|-- JoystickInputInterpreter
    InputInterpreter o-- Motor : leftMotor
    InputInterpreter o-- Motor : rightMotor
    InputInterpreter o-- ReflectanceSensor : leftSensor
    InputInterpreter o-- ReflectanceSensor : rightSensor
    InputInterpreter o-- BallShooter : ballShooter
    %% Factory
    class InputInterpreterFactory {
        +createInterpreter(State, Motor*, Motor*)
    }
    InputInterpreterFactory ..> InputInterpreter : creates
    %% StateMachine
    class StateMachine {
        -State state
        -unsigned long lineCrossedAt
        -ReflectanceSensor leftReflectanceSensor
        -ReflectanceSensor rightReflectanceSensor
        +update()
        +getState() const
    }
    class State {
        <<enum>>
        DEFAULT_STATE
        LINE_CROSSED
    }
    StateMachine o-- ReflectanceSensor : leftReflectanceSensor
    StateMachine o-- ReflectanceSensor : rightReflectanceSensor
    StateMachine o-- State
